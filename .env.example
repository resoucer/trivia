# Copie para .env.local e ajuste. Nenhuma variável é obrigatória em desenvolvimento.

# Banco libSQL/SQLite (padrão: file:data/trivia.db). Aceita libsql://... do Turso.
DATABASE_URL=file:data/trivia.db

# Segredo do HMAC que identifica visitantes sem cookie (IP + user agent, nunca guardados em claro).
# Obrigatório em produção. Gere com: openssl rand -base64 32
TRIVIA_VISITOR_SECRET=troque-por-um-segredo-aleatorio
